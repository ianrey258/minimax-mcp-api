# ─── Shared (both transports) ──────────────────────────────────────────────

# MiniMax platform API key (Bearer auth applied to every upstream call).
# Required in BOTH stdio and http mode.
MINIMAX_API_KEY=sk-...

# Base URL for the MiniMax platform
MINIMAX_API_URL=https://api.minimax.io

# Optional: log level for the stderr logger (debug | log | warn | error)
LOG_LEVEL=log

# Optional: development | production | test
NODE_ENV=development

# Transport: stdio (local, spawned by the client) | http (remote, streamable HTTP at /mcp)
MCP_TRANSPORT=stdio

# ─── stdio mode (MCP_TRANSPORT=stdio) ──────────────────────────────────────
# No extra variables. The client (Claude Desktop / Claude Code) spawns
# `node dist/main.js` itself. Its working directory is usually NOT this
# folder, so this .env may not be found: put MINIMAX_API_KEY in the client's
# MCP config "env" block instead.

# ─── http mode (MCP_TRANSPORT=http) ────────────────────────────────────────

# Port the HTTP server listens on (endpoint: POST /mcp)
PORT=3000

# Required in http mode: clients must send "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
